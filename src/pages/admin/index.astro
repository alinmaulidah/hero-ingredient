---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" active="dashboard">

  <div class="page-head">
    <div>
      <h1>Dashboard</h1>
      <div class="subtitle" id="page-subtitle">Memuat ringkasan…</div>
    </div>
    <div class="toolbar-actions">
      <button type="button" class="btn" id="refresh-btn">Segarkan</button>
      <a class="btn btn-primary" href="/admin/products/">Kelola Produk</a>
      <a class="btn" href="/admin/orders/">Lihat Pesanan</a>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Produk (Jenis Olahan)</div>
      <div class="stat-value" id="stat-options">–</div>
      <div class="stat-note"><span id="stat-groups">–</span> produk utama</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Pesanan Menunggu Bayar</div>
      <div class="stat-value" id="stat-pending">–</div>
      <div class="stat-note">status pembayaran masih pending</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Pesanan Dibayar</div>
      <div class="stat-value" id="stat-paid">–</div>
      <div class="stat-note">total <span id="stat-revenue">Rp 0</span></div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Total Pesanan</div>
      <div class="stat-value" id="stat-orders">–</div>
      <div class="stat-note">termasuk batal / refund</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Pesanan Terbaru</div>
    <div id="recent-orders"></div>
  </div>

</AdminLayout>

<script>
  import { escapeHtml } from '../../lib/catalogHtml';
  import { fetchStats, type OrderDto, type StatsDto } from '../../lib/admin/api';

  function formatIDR(value: number): string {
    return `Rp ${(Number(value) || 0).toLocaleString('id-ID')}`;
  }

  function formatDate(iso: string): string {
    if (!iso) return '—';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '—';
    return d.toLocaleString('id-ID', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  function statusLabel(status: string): string {
    const map: Record<string, string> = {
      pending: 'pending',
      paid: 'dibayar',
      cancelled: 'batal',
      refunded: 'refund',
      processed: 'diproses',
      shipped: 'dikirim',
      completed: 'selesai',
      settlement: 'dibayar',
      capture: 'dibayar'
    };
    return map[status] || status;
  }

  function renderRecent(orders: OrderDto[]): string {
    if (!orders.length) {
      return `<div class="empty-state">Belum ada pesanan masuk.</div>`;
    }

    const rows = orders
      .map((order) => {
        const payBadge = `<span class="badge badge-${escapeHtml(order.transactionStatus)}">${escapeHtml(statusLabel(order.transactionStatus))}</span>`;
        const fulfillBadge = `<span class="badge badge-${escapeHtml(order.orderStatus)}">${escapeHtml(statusLabel(order.orderStatus))}</span>`;
        return `
          <tr>
            <td class="muted">${escapeHtml(order.orderId)}</td>
            <td class="muted">${escapeHtml(formatDate(order.createdAt))}</td>
            <td>${escapeHtml(order.customerName || '—')}</td>
            <td class="num">${formatIDR(order.grossAmount)}</td>
            <td>${payBadge} ${fulfillBadge}</td>
          </tr>`;
      })
      .join('');

    return `
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Tanggal</th>
              <th>Customer</th>
              <th class="num">Total</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
  }

  async function loadStats() {
    const subtitleEl = document.getElementById('page-subtitle');
    const recentEl = document.getElementById('recent-orders');
    if (recentEl) recentEl.innerHTML = `<div class="loading">Memuat data…</div>`;

    try {
      const stats: StatsDto = await fetchStats();

      const set = (id: string, value: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      };

      set('stat-groups', String(stats.groups));
      set('stat-options', String(stats.options));
      set('stat-orders', String(stats.orders));
      set('stat-pending', String(stats.transactionBreakdown.pending || 0));
      set('stat-paid', String(stats.transactionBreakdown.paid || 0));
      set('stat-revenue', formatIDR(stats.paidRevenue));
      if (subtitleEl) {
        subtitleEl.textContent = `Terakhir diperbarui ${new Date().toLocaleTimeString('id-ID')}`;
      }
      if (recentEl) recentEl.innerHTML = renderRecent(stats.recentOrders);
    } catch (error) {
      if (recentEl) {
        recentEl.innerHTML = `<div class="alert alert-error">${
          error instanceof Error ? escapeHtml(error.message) : 'Gagal memuat data.'
        }</div>`;
      }
    }
  }

  loadStats();
  document.getElementById('refresh-btn')?.addEventListener('click', loadStats);
</script>
