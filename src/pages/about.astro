---
import Layout from '../layouts/Layout.astro';
import { company } from '../data/company';
---

<Layout title={`Tentang Kami - ${company.brand.siteName}`}>
  <main class="about-page">

    <!-- HERO SECTION -->
    <section class="about-hero">
      <div class="container">
        <span class="badge" data-lang-id="Tentang Kami" data-lang-en="About Us">Tentang Kami</span>
        <h1 data-lang-id="Pelopor Pengolahan & Rantai Pasok Bahan Baku Alam" data-lang-en="Pioneer in Natural Raw Material Processing & Supply Chain">
          Pelopor Pengolahan & Rantai Pasok Bahan Baku Alam
        </h1>
        <p data-lang-id="Menghubungkan kekayaan hayati lokal dengan standar industri global melalui inovasi pengolahan yang berkelanjutan." data-lang-en="Connecting local biodiversity with global industry standards through sustainable processing innovation.">
          Menghubungkan kekayaan hayati lokal dengan standar industri global melalui inovasi pengolahan yang berkelanjutan.
        </p>
      </div>
    </section>

    <!-- PROFIL PERUSAHAAN -->
    <section class="company-overview section-padding">
      <div class="container grid-2 align-center">
        <div class="overview-text">
          <h2 data-lang-id="Siapa Kami" data-lang-en="Who We Are">Siapa Kami</h2>
          <p>
            <strong>{company.brand.siteName}</strong> <span data-lang-id="adalah perusahaan terdepan dalam industri rantai pasok dan pengolahan bahan baku alam terpadu. Kami berfokus pada transformasi hasil alam berkualitas tinggi menjadi produk olahan siap pakai untuk industri makanan, minuman, farmasi, kosmetik, dan herbal." data-lang-en="is a leading company in the integrated natural raw material supply chain and processing industry. We focus on transforming high-quality natural resources into ready-to-use processed products for the food, beverage, pharmaceutical, cosmetic, and herbal industries.">adalah perusahaan terdepan dalam industri rantai pasok dan pengolahan bahan baku alam terpadu. Kami berfokus pada transformasi hasil alam berkualitas tinggi menjadi produk olahan siap pakai untuk industri makanan, minuman, farmasi, kosmetik, dan herbal.</span>
          </p>
          <p data-lang-id="Berbasis pada kekuatan sumber daya lokal, kami mengintegrasikan proses dari hulu hingga hilir untuk memastikan efisiensi, keamanan, serta mutu yang konsisten." data-lang-en="Based on the strength of local resources, we integrate upstream to downstream processes to ensure efficiency, safety, and consistent quality.">
            Berbasis pada kekuatan sumber daya lokal, kami mengintegrasikan proses dari hulu hingga hilir untuk memastikan efisiensi, keamanan, serta mutu yang konsisten.
          </p>
        </div>
        <div class="overview-stats">
          <div class="stat-card">
            <h3>100%</h3>
            <p data-lang-id="Bahan Baku Alam Pilihan" data-lang-en="Selected Natural Raw Materials">Bahan Baku Alam Pilihan</p>
          </div>
          <div class="stat-card">
            <h3>50+</h3>
            <p data-lang-id="Mitra Kelompok Tani" data-lang-en="Farmer Group Partners">Mitra Kelompok Tani</p>
          </div>
          <div class="stat-card">
            <h3>5+</h3>
            <p data-lang-id="Sertifikasi Standar Mutu" data-lang-en="Quality Standard Certifications">Sertifikasi Standar Mutu</p>
          </div>
          <div class="stat-card">
            <h3>Global</h3>
            <p data-lang-id="Pasar Ekspor & Lokal" data-lang-en="Export & Local Markets">Pasar Ekspor & Lokal</p>
          </div>
        </div>
      </div>
    </section>

    <!-- VISI & MISI -->
    <section class="vision-mission-section section-padding bg-light">
      <div class="container">
        <div class="section-header">
          <h2 data-lang-id="Visi & Misi" data-lang-en="Vision & Mission">Visi & Misi</h2>
          <p data-lang-id="Arah dan komitmen utama kami dalam mengembangkan industri bahan baku alam." data-lang-en="Our main direction and commitment in developing the natural raw material industry.">Arah dan komitmen utama kami dalam mengembangkan industri bahan baku alam.</p>
        </div>

        <div class="grid-2">
          <div class="vm-card vision-card">
            <span class="vm-label" data-lang-id="Visi" data-lang-en="Vision">Visi</span>
            <h3 data-lang-id="Menjadi Perusahaan Pengolahan Bahan Alam Terdepan" data-lang-en="Becoming a Leading Natural Material Processing Company">Menjadi Perusahaan Pengolahan Bahan Alam Terdepan</h3>
            <p data-lang-id="Menjadi perusahaan pengolahan bahan alam yang adaptif terhadap sumber daya lokal serta mampu merespons kebutuhan dan perkembangan pasar global secara berkelanjutan." data-lang-en="To become a natural material processing company that is adaptive to local resources and able to respond to the needs and developments of the global market sustainably.">
              Menjadi perusahaan pengolahan bahan alam yang adaptif terhadap sumber daya lokal serta mampu merespons kebutuhan dan perkembangan pasar global secara berkelanjutan.
            </p>
          </div>

          <div class="vm-card mission-card">
            <span class="vm-label" data-lang-id="Misi" data-lang-en="Mission">Misi</span>
            <ul class="mission-list">
              <li data-lang-id="Menyediakan bahan alam berkualitas tinggi dengan standar pengolahan terbaik." data-lang-en="Providing high-quality natural materials with the best processing standards.">Menyediakan bahan alam berkualitas tinggi dengan standar pengolahan terbaik.</li>
              <li data-lang-id="Mengembangkan jaringan rantai pasok lokal yang berkelanjutan dan berdampak positif." data-lang-en="Developing a sustainable and impactful local supply chain network.">Mengembangkan jaringan rantai pasok lokal yang berkelanjutan dan berdampak positif.</li>
              <li data-lang-id="Menghadirkan inovasi produk olahan bahan alam sesuai dengan tren pasar global." data-lang-en="Delivering innovative natural processed products aligned with global market trends.">Menghadirkan inovasi produk olahan bahan alam sesuai dengan tren pasar global.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- PILAR UTAMA KAMI -->
    <section class="pillars-section section-padding">
      <div class="container">
        <div class="section-header">
          <h2 data-lang-id="Pilar Utama Kami" data-lang-en="Our Main Pillars">Pilar Utama Kami</h2>
          <p data-lang-id="Prinsip operasional kami dalam menjalankan bisnis yang berdampak dan berkelanjutan." data-lang-en="Our operational principles in running an impactful and sustainable business.">Prinsip operasional kami dalam menjalankan bisnis yang berdampak dan berkelanjutan.</p>
        </div>

        <div class="grid-3">
          <div class="pillar-card">
            <span class="pillar-num">01</span>
            <h3 data-lang-id="Keberlanjutan" data-lang-en="Sustainability">Keberlanjutan</h3>
            <p data-lang-id="Menerapkan praktik pemanenan yang etis dan ramah lingkungan untuk menjaga kelestarian ekosistem serta ketersediaan rantai pasok jangka panjang." data-lang-en="Applying ethical and environmentally friendly harvesting practices to preserve ecosystems and ensure long-term supply chain availability.">Menerapkan praktik pemanenan yang etis dan ramah lingkungan untuk menjaga kelestarian ekosistem serta ketersediaan rantai pasok jangka panjang.</p>
          </div>

          <div class="pillar-card">
            <span class="pillar-num">02</span>
            <h3 data-lang-id="Pemberdayaan Lokal" data-lang-en="Local Empowerment">Pemberdayaan Lokal</h3>
            <p data-lang-id="Bermitra secara adil dengan petani lokal untuk meningkatkan kesejahteraan komunitas agrikultur serta menjaga standar hasil panen." data-lang-en="Partnering fairly with local farmers to improve the welfare of agricultural communities while maintaining harvest quality standards.">Bermitra secara adil dengan petani lokal untuk meningkatkan kesejahteraan komunitas agrikultur serta menjaga standar hasil panen.</p>
          </div>

          <div class="pillar-card">
            <span class="pillar-num">03</span>
            <h3 data-lang-id="Riset & Inovasi" data-lang-en="Research & Innovation">Riset & Inovasi</h3>
            <p data-lang-id="Menggunakan teknologi pengolahan dan ekstraksi mutakhir guna memastikan kandungan aktif bahan alam tetap terjaga maksimal." data-lang-en="Using state-of-the-art processing and extraction technology to ensure the active compounds of natural materials are preserved to the maximum.">Menggunakan teknologi pengolahan dan ekstraksi mutakhir guna memastikan kandungan aktif bahan alam tetap terjaga maksimal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STANDAR KUALITAS & JAMINAN -->
    <section class="quality-section section-padding bg-light">
      <div class="container grid-2 align-center">
        <div class="quality-text">
          <h2 data-lang-id="Jaminan Kualitas & Standar Industri" data-lang-en="Quality Assurance & Industry Standards">Jaminan Kualitas & Standar Industri</h2>
          <p data-lang-id="Kami memahami pentingnya ketepatan spesifikasi bahan baku dalam skala produksi industri. Oleh karena itu, setiap lot produksi melewati tahapan Quality Control (QC) yang ketat di laboratorium pengujian internal maupun independen." data-lang-en="We understand the importance of precise raw material specifications at industrial production scale. Therefore, every production lot passes through strict Quality Control (QC) stages at internal and independent testing laboratories.">
            Kami memahami pentingnya ketepatan spesifikasi bahan baku dalam skala produksi industri. Oleh karena itu, setiap lot produksi melewati tahapan Quality Control (QC) yang ketat di laboratorium pengujian internal maupun independen.
          </p>
          <ul class="check-list">
            <li data-lang-id="Pengujian parameter organoleptik, kadar air, dan kadar abu." data-lang-en="Testing of organoleptic parameters, moisture content, and ash content.">Pengujian parameter organoleptik, kadar air, dan kadar abu.</li>
            <li data-lang-id="Uji cemaran mikroba dan logam berat sesuai standar BPOM & Internasional." data-lang-en="Microbial and heavy metal contamination tests according to BPOM & International standards.">Uji cemaran mikroba dan logam berat sesuai standar BPOM & Internasional.</li>
            <li data-lang-id="Traceability (keterlacakan) penuh dari lahan hingga ke tangan mitra." data-lang-en="Full traceability from the farm to our partners' hands.">Traceability (keterlacakan) penuh dari lahan hingga ke tangan mitra.</li>
            <li data-lang-id="Dokumentasi lengkap: Technical Data Sheet (TDS) & Certificate of Analysis (COA)." data-lang-en="Complete documentation: Technical Data Sheet (TDS) & Certificate of Analysis (COA).">Dokumentasi lengkap: Technical Data Sheet (TDS) & Certificate of Analysis (COA).</li>
          </ul>
        </div>
        <div class="quality-box">
          <div class="quality-card-content">
            <h3 data-lang-id="Pengawasan Mutu Ketat" data-lang-en="Strict Quality Control">Pengawasan Mutu Ketat</h3>
            <p data-lang-id="Setiap bahan baku diproses dengan standar keamanan pangan, higienitas, serta verifikasi pengujian berkala." data-lang-en="Every raw material is processed under food safety and hygiene standards, along with periodic testing verification.">Setiap bahan baku diproses dengan standar keamanan pangan, higienitas, serta verifikasi pengujian berkala.</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .about-page {
    color: var(--text-dark);
    line-height: 1.6;
    background-color: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  /* HERO */
  .about-hero {
    background: var(--primary-dark);
    color: var(--white);
    padding: 7rem 0 5.5rem 0;
    text-align: center;
  }

  .about-hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    max-width: 800px;
    margin: 0 auto 1.25rem auto;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .about-hero p {
    font-size: 1.1rem;
    max-width: 620px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 300;
  }

  /* OVERVIEW & STATS */
  .overview-text h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 1.25rem;
    font-weight: 700;
  }

  .overview-text p {
    color: var(--text-muted);
    font-size: 0.975rem;
    margin-bottom: 1rem;
  }

  .overview-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .stat-card {
    background: var(--bg-light);
    border: 1px solid var(--border);
    padding: 1.75rem 1.25rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .stat-card h3 {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  .stat-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* VISI & MISI */
  .vm-card {
    background: var(--white);
    padding: 2.25rem 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .vm-label {
    display: inline-block;
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .vision-card h3 {
    font-size: 1.25rem;
    color: var(--primary-dark);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .vision-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .mission-list {
    list-style: none;
  }

  .mission-list li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .mission-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 6px;
    height: 6px;
    background-color: var(--primary);
    border-radius: 50%;
  }

  /* PILARS */
  .pillar-card {
    background: var(--white);
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .pillar-num {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-light);
    margin-bottom: 0.75rem;
  }

  .pillar-card h3 {
    font-size: 1.15rem;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .pillar-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* QUALITY */
  .quality-text h2 {
    font-size: 2rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .quality-text p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .check-list {
    list-style: none;
  }

  .check-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-dark);
    font-size: 0.925rem;
    font-weight: 500;
  }

  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
    transform: rotate(45deg);
  }

  .quality-box {
    background: var(--white);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    padding: 2.5rem 2rem;
    border-radius: var(--radius);
  }

  .quality-card-content h3 {
    font-size: 1.2rem;
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .quality-card-content p {
    color: var(--text-muted);
    font-size: 0.925rem;
    margin: 0;
  }

  /* RESPONSIVE STYLES */
  @media (max-width: 900px) {
    .overview-stats {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .about-hero {
      padding: 5rem 0 4rem 0;
    }
    .about-hero h1 {
      font-size: 2rem;
    }
    .about-hero p {
      font-size: 1rem;
    }

    .overview-text h2,
    .quality-text h2 {
      font-size: 1.65rem;
    }

    .pillar-card {
      border-left: 3px solid var(--primary-light);
    }
  }
</style>
