<!-- HERO SECTION -->
<section id="hero" class="hero">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <h1 data-lang-id="Inovasi Bahan Sesuai Kebutuhan" data-lang-en="Material Innovation Tailored to Needs">
      Inovasi Bahan Sesuai Kebutuhan
    </h1>
    <p data-lang-id="Memproses bahan alam sesuai kebutuhan." data-lang-en="Processing natural materials according to needs.">
      Memproses bahan alam sesuai kebutuhan.
    </p>
    <div class="hero-actions">
      <a href="#ingredients" class="btn btn-primary" data-lang-id="Lihat Produk" data-lang-en="View Products">Lihat Produk</a>
      <a href="/contact" class="btn btn-outline-light" data-lang-id="Mulai Konsultasi" data-lang-en="Start Consultation">Mulai Konsultasi</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: url('https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&q=80&w=1600') center/cover no-repeat;
    color: var(--white);
    padding: 9rem 0 7rem 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 30, 22, 0.82);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }
  .hero h1 {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .hero p {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2.5rem;
    font-weight: 300;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 6rem 0 5rem 0;
    }
    .hero h1 {
      font-size: 2.25rem;
    }
  }
</style>
