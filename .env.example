# Client key Midtrans (aman dikirim ke browser, dipakai Snap.js)
PUBLIC_MIDTRANS_CLIENT_KEY=

# true = app.midtrans.com (production), false = app.sandbox.midtrans.com
# Wajib diisi; jangan andalkan deteksi prefix (ada akun sandbox berformat Mid-).
PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Base URL backend Express (tanpa garis miring di akhir).
# Contoh: http://localhost:5000 — saat satu domain nanti bisa dikosongkan.
PUBLIC_API_BASE=http://localhost:5000

# Client ID Google (dipakai tombol "Masuk dengan Google" di halaman login).
# Sama dengan GOOGLE_CLIENT_ID di Backend/.env. Kosongkan = tombol disembunyikan.
PUBLIC_GOOGLE_CLIENT_ID=
