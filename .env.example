# ============================================================
# VARIABEL PUBLIK FRONTEND
# ============================================================
# PENTING: semua variabel berawalan PUBLIC_ di Astro "dibekukan"
# (di-inline) ke dalam HTML/JS saat BUILD, bukan saat aplikasi
# berjalan. Mengubah nilainya menuntut build ulang.
#
# Di Coolify isikan variabel ini sebagai "Build Variables"
# (bukan hanya "Environment Variables"). Lihat DEPLOY.md.

# ---- Backend Express (Indonesia Ingredient) ----
# URL backend, tanpa garis miring di akhir.
# Lokal  : http://localhost:5000
# Produksi: URL aplikasi backend di Coolify, mis. https://api.heroingredient.com
PUBLIC_API_BASE=http://localhost:5000

# ---- Midtrans ----
# Client key (aman tampil di browser, dipakai Snap.js).
# Wajib SAMA MODE-nya dengan MIDTRANS_SERVER_KEY di Backend/.env.
PUBLIC_MIDTRANS_CLIENT_KEY=

# true = app.midtrans.com (produksi), false = app.sandbox.midtrans.com
# Wajib diisi; jangan andalkan deteksi prefix (ada akun sandbox berformat Mid-).
PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ---- Google ----
# Client ID Google, HARUS sama persis dengan GOOGLE_CLIENT_ID di Backend/.env.
# Domain situs ini juga harus terdaftar di "Authorized JavaScript origins".
# Kosongkan = tombol "Masuk dengan Google" disembunyikan.
PUBLIC_GOOGLE_CLIENT_ID=
